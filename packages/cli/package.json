{
  "name": "@mahmudul-hasan/seo-audit",
  "version": "0.1.1",
  "description": "Professional-grade SEO site audit CLI — crawl and audit any website from the terminal",
  "type": "module",
  "bin": {
    "seo-audit": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mahmudul-hasan-hridoy/seo-audit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/mahmudul-hasan-hridoy/seo-audit#readme",
  "bugs": {
    "url": "https://github.com/mahmudul-hasan-hridoy/seo-audit/issues"
  },
  "author": "Mahmudul Hasan",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.0.0",
    "conf": "^13.0.0",
    "open": "^10.1.0",
    "ora": "^8.0.0",
    "seo-auditor": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "seo",
    "audit",
    "cli",
    "crawler",
    "performance",
    "technical-seo",
    "site-audit"
  ]
