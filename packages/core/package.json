{
  "name": "seo-auditor",
  "version": "0.1.0",
  "description": "Professional-grade SEO site audit tool — programmatic library for crawling and auditing websites",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mahmudul-hasan-hridoy/seo-audit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/mahmudul-hasan-hridoy/seo-audit#readme",
  "bugs": {
    "url": "https://github.com/mahmudul-hasan-hridoy/seo-audit/issues"
  },
  "author": "Mahmudul Hasan",
  "license": "MIT",
  "dependencies": {
    "linkedom": "^0.18.0",
    "p-limit": "^6.0.0",
    "robots-parser": "^3.0.1",
    "undici": "^6.10.0"
  },
  "optionalDependencies": {
    "puppeteer": "^22.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "seo",
    "audit",
    "crawler",
    "performance",
    "technical-seo",
    "site-audit",
    "accessibility"
  ]
}
